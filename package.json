{
  "name": "pokemon_tcgp_controll",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "download:images": "tsx scripts/download-images.ts",
    "sync:decks": "tsx scripts/sync-decks.ts",
    "postinstall": "prisma generate",
    "test:db:up": "docker compose --profile test up -d --wait db_test",
    "test:db:down": "docker compose --profile test down",
    "test:db:push": "tsx scripts/test-db-setup.ts",
    "test": "npm run test:db:up && vitest run",
    "test:watch": "npm run test:db:up && vitest",
    "test:coverage": "npm run test:db:up && vitest run --coverage",
    "test:e2e": "npm run test:db:up && playwright test",
    "test:e2e:ui": "npm run test:db:up && playwright test --ui"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.3",
    "prisma": "^7.10.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
