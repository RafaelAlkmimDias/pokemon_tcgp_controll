generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Collection {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  // Portuguese name, from the same source as `name` (sets.json). Falls back
  // to `name` (English) when missing. Never shown unless locale is "pt".
  namePt      String?
  series      String
  releaseDate DateTime?
  cardCount   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packs Pack[]
  cards Card[]

  @@map("collections")
}

model Pack {
  id           String   @id @default(cuid())
  name         String
  collectionId String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  cards      CardPack[]

  @@unique([collectionId, name])
  @@map("packs")
}

enum Rarity {
  C
  U
  R
  RR
  AR
  SR
  SAR
  IM
  UR
  S
  SSR
  UNKNOWN
}

enum CardType {
  POKEMON
  SUPPORTER
  ITEM
  FOSSIL
  TOOL
}

// A unique physical printing (artwork) of a card. The same print can be
// reissued across multiple collections (e.g. Deluxe Pack reprints) - those
// Card rows all point at the same Print, so marking one owned marks all of
// them owned.
model Print {
  id            String   @id @default(cuid())
  imageUrl      String   @unique
  ownedQuantity Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cards Card[]

  @@map("prints")
}

model Card {
  id           String    @id @default(cuid())
  collectionId String
  printId      String
  number       Int
  name         String
  // Portuguese name, matched by internal asset ID against
  // prisma/data/card-names-pt.json (see its README for provenance). Falls
  // back to `name` (English) when missing. Never shown unless locale is "pt".
  namePt       String?
  rarity       Rarity    @default(UNKNOWN)
  type         CardType?
  element      String?
  stage        String?
  health       Int?
  retreatCost  Int?
  weakness     String?
  evolvesFrom  String?
  goodWith     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  print      Print      @relation(fields: [printId], references: [id])
  packs      CardPack[]
  decks      DeckCard[]

  @@unique([collectionId, number])
  @@map("cards")
}

model CardPack {
  cardId String
  packId String

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([cardId, packId])
  @@map("card_packs")
}

// A competitive deck archetype, synced from tournament meta data
// (scripts/sync-decks.ts). Every field is re-derived on each sync except
// isBuilt, which is user state and must never be touched by the sync.
model Deck {
  id              String   @id @default(cuid())
  slug            String   @unique
  displayName     String
  popularity      Float
  expectedWinRate Float
  powerScore      Float?
  metaScore       Float?
  isBuilt         Boolean  @default(false)
  syncedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cards DeckCard[]

  @@map("decks")
}

model DeckCard {
  deckId   String
  cardId   String
  quantity Int

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([deckId, cardId])
  @@map("deck_cards")
}
